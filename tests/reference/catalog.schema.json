{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conservative GameMaker name metadata catalog",
  "type": "object",
  "required": ["schema_version", "source_sha256", "policy", "counts", "entries", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "source_name": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"type": "string"},
    "counts": {
      "type": "object",
      "required": ["total", "functions", "variables", "constants", "unverified"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "functions": {"type": "integer", "minimum": 0},
        "variables": {"type": "integer", "minimum": 0},
        "constants": {"type": "integer", "minimum": 0},
        "unverified": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "readonly", "arguments", "fixed_arity", "variadic", "return_kind", "side_effects", "status", "evidence", "source_line"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["function", "variable", "constant"]},
          "readonly": {"type": "boolean"},
          "arguments": {"type": ["array", "null"], "items": {"type": "string"}},
          "fixed_arity": {"type": ["integer", "null"], "minimum": 0},
          "variadic": {"type": "boolean"},
          "return_kind": {"type": "string"},
          "side_effects": {"type": "string"},
          "status": {"enum": ["implemented", "stub", "unsupported", "unverified"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "source_line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
